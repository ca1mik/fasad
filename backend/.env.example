APP_NAME=Fasad Production Platform
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://fasad:fasad@db:5432/fasad
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_STORAGE_PATH=./storage_data
DEFAULT_CURRENCY=RUB
FIRST_SUPERUSER_LOGIN=admin
FIRST_SUPERUSER_PASSWORD=admin123

# Symmetric key for channel credentials (IMAP/SMTP passwords, bot tokens).
# Change before storing real credentials — rotating it makes stored secrets unreadable.
CHANNEL_SECRET_KEY=change-me
# Default poll interval for channels that do not override it in their config.
CHANNEL_POLL_DEFAULT_INTERVAL_SECONDS=120
CHANNEL_POLL_MIN_INTERVAL_SECONDS=30
# How often the scheduler process looks for due channels.
CHANNEL_SCHEDULER_TICK_SECONDS=15
# Run polls inside the scheduler process instead of the RQ worker.
# Set true for local dev on Windows, where rq cannot be imported.
CHANNEL_POLL_INLINE=false
# Max messages pulled from IMAP per poll job.
EMAIL_POLL_BATCH_LIMIT=25
# Attachments above this size are recorded by name/size only, without content.
EMAIL_MAX_ATTACHMENT_MB=15
EMAIL_CONNECT_TIMEOUT_SECONDS=20

# Files a manager attaches to an order by hand (sketches, measurements, scans).
ORDER_FILE_MAX_MB=25

# Signature appended to every cold-outreach letter (scripts/outreach.py).
# Must carry the sender's legal name and INN plus where the address came from:
# without them a business letter reads as anonymous advertising. Use \n for line breaks.
OUTREACH_SIGNATURE=

# Daily ceiling for cold outreach letters from one mailbox. Above 25-30 a day
# mail providers start treating the sender as a bulk mailer and throttle delivery.
OUTREACH_DAILY_LIMIT=25

# Node-lock the portable (USB) build to one computer, see app/core/license.py.
# Leave false for normal dev and docker prod — only build-portable.ps1 sets
# this true in the portable build's own .env.
LICENSE_LOCK_ENABLED=false

