# Адрес API для браузера. Относительный путь — фронт проксирует запросы
# на бэкенд сам (см. rewrites в next.config.ts), поэтому система работает
# и локально, и через туннель по публичному адресу.
NEXT_PUBLIC_API_URL=/api/v1

# Адрес API для серверного рендера — только абсолютный.
API_URL=http://backend:8000/api/v1

# Куда фронт проксирует /api/v1.
BACKEND_ORIGIN=http://backend:8000
